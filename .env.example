# Optional: any OpenAI-compatible chat-completions endpoint.
# The client POSTs to {LLM_BASE_URL}/chat/completions. Keep the key local and
# never commit it. If either LLM_API_KEY or LLM_MODEL is empty, the app uses
# the short grounded offline fallback (not a raw textbook excerpt).
LLM_API_KEY=
LLM_MODEL=
# OpenAI: https://api.openai.com/v1; compatible providers should expose the
# same /chat/completions route below their configured base URL.
LLM_BASE_URL=https://api.openai.com/v1
# Keep student requests responsive; slow provider calls use the grounded fallback.
LLM_TIMEOUT=12
LLM_TIMEOUT_SECONDS=12
LLM_MAX_RETRIES=1
LLM_MAX_RESPONSE_BYTES=1000000
LLM_MAX_CONTENT_CHARS=12000
LLM_FAILURE_COOLDOWN_SECONDS=60

# Answer and retrieval bounds shared by the runtime config.
RETRIEVAL_TOP_K=3
ANSWER_MAX_WORDS=180
EVIDENCE_MAX_CHARS=900

# Optional neural vector backend for RAG. The default local_hash backend is
# deterministic and offline; openai_compatible batches all indexed chunks.
RAG_EMBEDDING_BACKEND=local_hash
RAG_HASH_DIMENSION=384
RAG_RETRIEVAL_CACHE_SIZE=256
RAG_EMBEDDING_FAILURE_COOLDOWN_SECONDS=60
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_BATCH_SIZE=64
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RESPONSE_BYTES=10000000

# API protection for a local or single-instance deployment.
API_RATE_LIMIT_PER_MINUTE=60
API_RATE_LIMIT_CLIENT_CAP=10000
MAX_JSON_BODY_BYTES=1000000
MAX_QUESTION_CHARS=4000
REQUEST_SOCKET_TIMEOUT_SECONDS=10
TUTOR_MEMORY_PATH=artifacts/tutor_memory.sqlite3
# Each session retains this many simulation turns and quiz attempts separately.
MAX_SESSION_EVENTS=1000
# 0 disables automatic cleanup; use a positive day count for hosted demos.
MEMORY_RETENTION_DAYS=0
# Minimal local accounts for the interview demo. Cookies remain HttpOnly;
# enable Secure only when serving over HTTPS.
AUTH_SESSION_DAYS=30
AUTH_COOKIE_SECURE=0
